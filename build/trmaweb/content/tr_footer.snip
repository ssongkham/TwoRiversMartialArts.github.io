        <div class="tr-footer__base">
          <div class="tr-footer__tenets">
            {% for ko, rom, en, gloss in TENETS %}<span>{{ en }}</span>{% endfor %}
          </div>
          <p class="tr-footer__legal">Two Rivers Martial Arts &middot; 501(c)(3) nonprofit</p>
        </div>
      </div>
    </footer>
