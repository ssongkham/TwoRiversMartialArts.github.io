{# Footer. The five tenet names sit above the legal line on every page. #}
    <footer class="tr-footer">
      <div class="tr-wrap">
        <nav>
          <a href={{linkto("classes.html")}}>Classes &amp; Locations</a>
          <a href={{linkto("start-here.html")}}>Start Here</a>
          <a href={{linkto("history-trma.html")}}>About</a>
          <a href={{linkto("instructors-primary.html")}}>Instructors</a>
